#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Headscale control server
# ==============================================================================
if ! python3 -m hsha.gate headscale; then
    sleep 30
    exit 0
fi

bashio::log.info "Starting Headscale $(headscale version 2>/dev/null | head -n1 | awk '{print $3}')"
date +%s > /run/hsha/headscale-started
# The log goes through hsha.regwatch: it passes every line on unchanged and notes
# browser sign-ins that wait for approval, so the panel can show them.
exec headscale -c /data/headscale/config.yaml serve > >(exec python3 -m hsha.regwatch) 2>&1
