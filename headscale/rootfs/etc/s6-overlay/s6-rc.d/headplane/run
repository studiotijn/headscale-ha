#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Headplane admin UI (runs unprivileged)
# ==============================================================================
if [[ "$(python3 -m hsha.opt headplane)" != "true" ]]; then
    bashio::log.info "Headplane disabled"
    exec sleep infinity
fi

if ! python3 -m hsha.gate headplane; then
    sleep 30
    exit 0
fi

export HEADPLANE_CONFIG_PATH=/data/headplane/config.yaml
cd /app || bashio::exit.nok "Headplane is missing from the image"
bashio::log.info "Starting Headplane on port $(python3 -m hsha.opt headplane_port)"
exec s6-setuidgid headplane node /app/build/server/index.js
